**/site-packages/
**/*.dist-info/
frontend/Lib/
frontend/Scripts/

# ===== COMPILED EXTENSIONS =====
*.pyd
*.dll
*.dylib

# ===== PROFILING DATA =====
.prof
*.prof

# ===== SECURITY SCANNERS =====
.bandit
safety-report.txt

# ===== DEPLOYMENT FILES =====
docker-compose.override.yml
.dockerignore
deployments/local/tmp*/

# ===== PROJECT-SPECIFIC EXCLUSIONS =====
# Cleanup and maintenance scripts
repository_cleanup*.py
cleanup_*.py
*_cleanup.py
!tools/root_cleanup.py
!tools/maintenance/focused_cleanup.py
!tools/maintenance/safe_cleanup.py
!tools/maintenance/smart_cleanup.py
!Aetherra/aetherra_core/agents/cleanup_project.py
!Aetherra/scripts/cleanup_project.py
!Aetherra/scripts/conservative_cleanup.py
!Aetherra/scripts/fast_cleanup.py

# Discord Bot directory (contains sensitive tokens and configurations)
Discord Bot/

# Website directory (kept out of core repo; deployed via dedicated action in separate context)
# Prevent accidental inclusion of site sources/build artifacts.
aetherra-website/

# Temporary development files
scratch/
playground/
experiments/
dev_test/

# Large binary files that shouldn't be versioned
*.mp4
*.avi
*.mov
*.mkv
*.mp3
*.wav
*.flac

# Generated or downloaded models
models/
weights/
checkpoints/
*.bin
*.pt
*.pth
*.ckpt

# ===== IGNORE PATTERNS FOR COMMON MISTAKES =====
# Backup files from editors
*~
*.orig
*.rej

# Compressed archives
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.7z
*.rar

# ===== ALLOW THESE IMPORTANT FILES =====
# Make sure these files are never ignored (override any patterns above)
!requirements.txt
!.env.example
!.gitignore
!README.md
!CONTRIBUTING.md
!LICENSE
!.github/

# ===== VIRTUAL ENVIRONMENT BINARIES =====
# Ignore virtual environment executables but allow the structure
Scripts/*.exe
Scripts/*.bat
Scripts/*.cmd
scripts/*.exe
scripts/*.bat
scripts/*.cmd

# ===== FINAL CATCH-ALL =====
# Any additional files that shouldn't be committed
.aetherra/
.aetherra_temp*
*.tmp.*
temp_*
*_temp.*
