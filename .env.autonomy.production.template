# Aetherra OS - Production Autonomy Environment Variables
# Copy to .env.autonomy.production and fill in tokens
# ⚠️  CRITICAL: Generate strong tokens, enable TLS, configure offsite backups

# ============================================================================
# PROFILE & CORE
# ============================================================================
AETHERRA_PROFILE=prod
AETHERRA_LOG_LEVEL=INFO
AETHERRA_CONFIG_PATH=config.autonomy.production.json

# ============================================================================
# CONSCIOUSNESS & AUTONOMY
# ============================================================================
AETHERRA_AUTONOMY_MODE=auto
AETHERRA_SAFETY_ENVELOPE_ENABLED=1
AETHERRA_TICK_HZ=1
AETHERRA_ENABLE_QFAC=1
AETHERRA_QFAC_NARRATIVE_PERSISTENCE=1

# Autopilot - NO opt-in required in prod (trust metrics gate activation)
AETHERRA_AUTOPILOT_OPT_IN=0
AETHERRA_AUTOPILOT_MIN_TRUST=0.7
AETHERRA_AUTOPILOT_MIN_SNCI=0.6
AETHERRA_AUTOPILOT_MIN_SUCCESS=0.85
AETHERRA_AUTOPILOT_ACTION_WINDOW=100

# ============================================================================
# MAINTENANCE SYSTEM
# ============================================================================
AETHERRA_HOMEOSTASIS_ENABLED=1
AETHERRA_HOMEOSTASIS_MODE=active
AETHERRA_HOMEOSTASIS_MAX_ACTIONS_PER_HOUR=5
AETHERRA_HOMEOSTASIS_COOLDOWN_SECONDS=120

AETHERRA_SELF_IMPROVEMENT_ENABLED=1
AETHERRA_SELF_IMPROVEMENT_HMR=1
AETHERRA_SELF_IMPROVEMENT_REQUIRE_APPROVAL=0
AETHERRA_SELF_IMPROVEMENT_AUTO_APPLY_THRESHOLD=0.9

AETHERRA_SELF_INCORPORATION_ENABLED=1
AETHERRA_SELF_INCORPORATION_DISCOVERY_MODE=safe
AETHERRA_SELF_INCORPORATION_TEST_BEFORE_INTEGRATE=1
AETHERRA_SELF_INCORPORATION_REQUIRE_REVIEW=0

# ============================================================================
# AGENT ORCHESTRATOR
# ============================================================================
AETHERRA_AGENTS_API_ENABLED=1
AETHERRA_AGENTS_API_REQUIRE_TOKEN=1
AETHERRA_AGENTS_API_TOKEN=<GENERATE_PRODUCTION_TOKEN_256BIT>
AETHERRA_AGENTS_TICK_HZ=1
AETHERRA_AGENTS_MAX_CONCURRENT=20
AETHERRA_AGENTS_TASK_TIMEOUT=600

# ============================================================================
# CODING AUTOPILOT
# ============================================================================
AETHERRA_CODING_AUTOPILOT_ENABLED=1
AETHERRA_SPEC_TO_TESTS_GATE=1
AETHERRA_MANDATORY_TEST_PASS=1
AETHERRA_REQUIRE_LINT=1
AETHERRA_REQUIRE_SIGNATURE=1
AETHERRA_ALLOW_SELF_EDIT=1
AETHERRA_MAX_CHANGES_PER_HOUR=5

# ============================================================================
# MEMORY SYSTEM
# ============================================================================
AETHERRA_MEMORY_ENGINE=sqlite
AETHERRA_MEMORY_QFAC_ENABLED=1
AETHERRA_STORM_ENABLED=1
AETHERRA_STORM_MODE=active
AETHERRA_STORM_FALLBACK_TO_SHADOW=1
AETHERRA_MEMORY_BACKUP_INTERVAL_HOURS=1

# ============================================================================
# HUB API & SECURITY
# ============================================================================
AETHERRA_AI_API_ENABLED=1
AETHERRA_AI_API_REQUIRE_TOKEN=1
AETHERRA_AI_API_TOKEN=<GENERATE_PRODUCTION_TOKEN_256BIT>
AETHERRA_AI_API_RATE_LIMIT_RPM=120
AETHERRA_AI_API_RATE_LIMIT_BURST=20
AETHERRA_AI_API_AUDIT_LOGGING=1

AETHERRA_HUB_PORT=3001
AETHERRA_HUB_HOST=0.0.0.0
AETHERRA_HUB_TLS_ENABLED=1
AETHERRA_HUB_TLS_CERT_PATH=/etc/aetherra/tls/cert.pem
AETHERRA_HUB_TLS_KEY_PATH=/etc/aetherra/tls/key.pem
AETHERRA_HUB_CORS_STRICT=1

# ============================================================================
# SECURITY & NETWORK
# ============================================================================
AETHERRA_SAFETY_MODE=strict
AETHERRA_NET_STRICT=1
AETHERRA_NETWORK_ALLOWLIST=localhost,127.0.0.1,api.aetherra.dev

# Token management
AETHERRA_TOKEN_ROTATION_DAYS=14
AETHERRA_TOKEN_MIN_ENTROPY=256

# Capability restrictions
AETHERRA_DENY_CAPABILITIES=file:delete_system,exec:privileged

# ============================================================================
# OBSERVABILITY & MONITORING
# ============================================================================
AETHERRA_METRICS_EXPORT=1
AETHERRA_PROMETHEUS_ENABLED=1
AETHERRA_PROMETHEUS_PORT=9090
AETHERRA_THINK_STREAM_UI=1
AETHERRA_DASHBOARD_ENABLED=1

# Alert thresholds (stricter in prod)
AETHERRA_ALERT_CONSCIOUSNESS_COHERENCE_MIN=0.75
AETHERRA_ALERT_HOMEOSTASIS_STABILITY_MIN=0.85
AETHERRA_ALERT_AGENT_SUCCESS_MIN=0.75
AETHERRA_ALERT_MEMORY_LATENCY_MAX_MS=150

# External alerting (configure when ready)
AETHERRA_PAGERDUTY_ENABLED=0
AETHERRA_PAGERDUTY_API_KEY=<CONFIGURE_IF_NEEDED>
AETHERRA_SLACK_ALERTS_ENABLED=0
AETHERRA_SLACK_WEBHOOK_URL=<CONFIGURE_IF_NEEDED>

# ============================================================================
# BACKUP & RECOVERY
# ============================================================================
AETHERRA_BACKUP_STRATEGY=3-2-1
AETHERRA_BACKUP_MEMORY_DB=hourly
AETHERRA_BACKUP_CONFIGS=daily
AETHERRA_BACKUP_PLUGINS=daily
AETHERRA_BACKUP_SCRIPTS=daily
AETHERRA_BACKUP_FULL_SYSTEM=weekly

AETHERRA_BACKUP_RETENTION_HOURLY=48
AETHERRA_BACKUP_RETENTION_DAILY=14
AETHERRA_BACKUP_RETENTION_WEEKLY=8
AETHERRA_BACKUP_RETENTION_MONTHLY=12

# ⚠️  CRITICAL: Configure offsite backups for production
AETHERRA_BACKUP_OFFSITE_ENABLED=1
AETHERRA_BACKUP_OFFSITE_PROVIDER=s3
AETHERRA_BACKUP_OFFSITE_BUCKET=<YOUR_S3_BUCKET>
AETHERRA_BACKUP_OFFSITE_REGION=<YOUR_REGION>
AETHERRA_BACKUP_OFFSITE_ACCESS_KEY=<YOUR_ACCESS_KEY>
AETHERRA_BACKUP_OFFSITE_SECRET_KEY=<YOUR_SECRET_KEY>
AETHERRA_BACKUP_VERIFY=1

# ============================================================================
# INTERACTIVE LYRIXA
# ============================================================================
AETHERRA_INTERACTIVE_ENABLED=1
AETHERRA_INTERACTIVE_DEFAULT_EMOTION=calm
AETHERRA_INTERACTIVE_TRANSITION_DURATION=2.0

# ============================================================================
# PRODUCTION HARDENING
# ============================================================================
AETHERRA_DEV_MODE=0
AETHERRA_FORCE_OFFLINE=0
AETHERRA_MOCK_EXTERNAL_SERVICES=0
AETHERRA_PANIC_ON_CRITICAL_ERROR=0
AETHERRA_GRACEFUL_SHUTDOWN_TIMEOUT=30
