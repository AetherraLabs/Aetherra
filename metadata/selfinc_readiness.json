        {
            "var": "AETHERRA_SCRIPT_VERIFY_STRICT",
            "required": "1",
            "purpose": "Script signature strictness",
            "auto": "Abort if unset"
        },
        {
            "var": "AETHERRA_SIGNING_STRICT",
            "required": "1",
            "purpose": "Plugin signing strict mode",
            "auto": "Abort if unset"
        },
        {
            "var": "AETHERRA_NET_STRICT",
            "required": "1",
            "purpose": "Restrict outbound network",
            "auto": "Auto-enable + allowlist"
