        {
            "var": "AETHERRA_NETWORK_ALLOWLIST",
            "required": "Value list",
            "purpose": "Hosts allowlist",
            "auto": "Defaults if missing"
        },
        {
            "var": "AETHERRA_AI_API_ENABLED",
            "required": "1 (if AI API)",
            "purpose": "Enable AI endpoints",
            "auto": "Warn if insecure"
        },
        {
            "var": "AETHERRA_AI_API_REQUIRE_TOKEN",
            "required": "1 (if AI API)",
            "purpose": "Require auth token",
            "auto": "Failure recorded if missing"
