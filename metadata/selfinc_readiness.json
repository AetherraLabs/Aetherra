        {
            "var": "AETHERRA_AI_API_TOKEN / AETHERRA_HUB_CONTROL_TOKEN",
            "required": "Yes",
            "purpose": "Authentication secret",
            "auto": "Required if require_token=1"
        },
        {
            "var": "AETHERRA_SELFINC_ENABLED",
            "required": "1 (optional)",
            "purpose": "Auto startup task",
            "auto": "Idle if missing"
        }
