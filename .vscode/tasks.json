{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Safe Ingest + Evaluate (docs/self)",
			"type": "shell",
			"command": "python",
			"args": [
				"tools/ingest_safe.py",
				"docs/self",
				"--run",
				"--eval"
			],
			"group": "build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Evaluate Learning KPIs (Golden Set)",
			"type": "shell",
			"command": "python",
			"args": [
				"tools/learning_evaluator.py",
				"tests/data/golden_learning_set.json"
			],
			"group": "test",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Doctor",
			"type": "shell",
			"command": "./tools/project-doctor.sh",
			"windows": {
				"command": "powershell.exe -ExecutionPolicy Bypass -File .\\tools\\project-doctor.ps1"
			},
			"problemMatcher": [
				"$eslint-stylish",
				"$eslint-compact",
				"$tsc",
				"$python",
				{
					"owner": "ruff",
					"fileLocation": "autoDetect",
					"pattern": {
						"regexp": "^(.*?):(\\d+):(\\d+): ([A-Z]\\d{3,4}) (.*)$",
						"file": 1,
						"line": 2,
						"column": 3,
						"code": 4,
						"message": 5
					}
				},
				{
					"owner": "mypy",
					"fileLocation": "autoDetect",
					"pattern": {
						"regexp": "^(.*?):(\\\\d+):(?:(\\\\d+):)? (error|note|warning): (.*?)(?: \\\\[(.*)\\\\])?$",
						"file": 1,
						"line": 2,
						"column": 3,
						"severity": 4,
						"message": 5,
						"code": 6
					}
				}
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Doctor (Check only)",
			"type": "shell",
			"command": "./tools/project-doctor.sh --check",
			"windows": {
				"command": "powershell.exe -ExecutionPolicy Bypass -File .\\tools\\project-doctor.ps1 --check"
			},
			"problemMatcher": [
				"$python"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Doctor (Guarded fix)",
			"type": "shell",
