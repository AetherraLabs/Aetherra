# Aetherra OS - Staging Autonomy Environment Variables
# Copy to .env.autonomy.staging and fill in tokens

# ============================================================================
# PROFILE & CORE
# ============================================================================
AETHERRA_PROFILE=staging
AETHERRA_LOG_LEVEL=DEBUG
AETHERRA_CONFIG_PATH=config.autonomy.staging.json

# ============================================================================
# CONSCIOUSNESS & AUTONOMY
# ============================================================================
AETHERRA_AUTONOMY_MODE=suggest
AETHERRA_SAFETY_ENVELOPE_ENABLED=1
AETHERRA_TICK_HZ=1
AETHERRA_ENABLE_QFAC=1
AETHERRA_QFAC_NARRATIVE_PERSISTENCE=1

# Autopilot eligibility thresholds
AETHERRA_AUTOPILOT_OPT_IN=1
AETHERRA_AUTOPILOT_MIN_TRUST=0.6
AETHERRA_AUTOPILOT_MIN_SNCI=0.5
AETHERRA_AUTOPILOT_MIN_SUCCESS=0.8
AETHERRA_AUTOPILOT_ACTION_WINDOW=50

# ============================================================================
# MAINTENANCE SYSTEM
# ============================================================================
AETHERRA_HOMEOSTASIS_ENABLED=1
AETHERRA_HOMEOSTASIS_MODE=active_limited
AETHERRA_HOMEOSTASIS_MAX_ACTIONS_PER_HOUR=10
AETHERRA_HOMEOSTASIS_COOLDOWN_SECONDS=60

AETHERRA_SELF_IMPROVEMENT_ENABLED=1
AETHERRA_SELF_IMPROVEMENT_HMR=1
AETHERRA_SELF_IMPROVEMENT_REQUIRE_APPROVAL=1

AETHERRA_SELF_INCORPORATION_ENABLED=1
AETHERRA_SELF_INCORPORATION_DISCOVERY_MODE=safe
AETHERRA_SELF_INCORPORATION_TEST_BEFORE_INTEGRATE=1

# ============================================================================
# AGENT ORCHESTRATOR
# ============================================================================
AETHERRA_AGENTS_API_ENABLED=1
AETHERRA_AGENTS_API_REQUIRE_TOKEN=1
AETHERRA_AGENTS_API_TOKEN=<GENERATE_STAGING_TOKEN>
AETHERRA_AGENTS_TICK_HZ=1
AETHERRA_AGENTS_MAX_CONCURRENT=10
AETHERRA_AGENTS_TASK_TIMEOUT=300

# ============================================================================
# CODING AUTOPILOT
# ============================================================================
AETHERRA_CODING_AUTOPILOT_ENABLED=1
AETHERRA_SPEC_TO_TESTS_GATE=1
AETHERRA_MANDATORY_TEST_PASS=1
AETHERRA_REQUIRE_LINT=1
AETHERRA_REQUIRE_SIGNATURE=1

# ============================================================================
# MEMORY SYSTEM
# ============================================================================
AETHERRA_MEMORY_ENGINE=sqlite
AETHERRA_MEMORY_QFAC_ENABLED=1
AETHERRA_STORM_ENABLED=1
AETHERRA_STORM_MODE=shadow
AETHERRA_MEMORY_BACKUP_INTERVAL_HOURS=1

# ============================================================================
# HUB API & SECURITY
# ============================================================================
AETHERRA_AI_API_ENABLED=1
AETHERRA_AI_API_REQUIRE_TOKEN=1
AETHERRA_AI_API_TOKEN=<GENERATE_STAGING_TOKEN>
AETHERRA_AI_API_RATE_LIMIT_RPM=60
AETHERRA_AI_API_RATE_LIMIT_BURST=10
AETHERRA_AI_API_AUDIT_LOGGING=1

AETHERRA_HUB_PORT=3001
AETHERRA_HUB_HOST=127.0.0.1
AETHERRA_HUB_CORS_STRICT=0

# ============================================================================
# SECURITY & NETWORK
# ============================================================================
AETHERRA_SAFETY_MODE=standard
AETHERRA_NET_STRICT=0
AETHERRA_NETWORK_ALLOWLIST=localhost,127.0.0.1,*.aetherra.dev

# Token management
AETHERRA_TOKEN_ROTATION_DAYS=30
AETHERRA_TOKEN_MIN_ENTROPY=128

# ============================================================================
# OBSERVABILITY & MONITORING
# ============================================================================
AETHERRA_METRICS_EXPORT=1
AETHERRA_PROMETHEUS_ENABLED=1
AETHERRA_THINK_STREAM_UI=1
AETHERRA_DASHBOARD_ENABLED=1

# Alert thresholds
AETHERRA_ALERT_CONSCIOUSNESS_COHERENCE_MIN=0.7
AETHERRA_ALERT_HOMEOSTASIS_STABILITY_MIN=0.8
AETHERRA_ALERT_AGENT_SUCCESS_MIN=0.7
AETHERRA_ALERT_MEMORY_LATENCY_MAX_MS=200

# ============================================================================
# BACKUP & RECOVERY
# ============================================================================
AETHERRA_BACKUP_STRATEGY=3-2-1
AETHERRA_BACKUP_MEMORY_DB=hourly
AETHERRA_BACKUP_CONFIGS=daily
AETHERRA_BACKUP_RETENTION_HOURLY=24
AETHERRA_BACKUP_RETENTION_DAILY=7
AETHERRA_BACKUP_OFFSITE_ENABLED=0

# ============================================================================
# INTERACTIVE LYRIXA
# ============================================================================
AETHERRA_INTERACTIVE_ENABLED=1
AETHERRA_INTERACTIVE_DEFAULT_EMOTION=calm
AETHERRA_INTERACTIVE_TRANSITION_DURATION=2.0

# ============================================================================
# DEVELOPMENT FLAGS (STAGING ONLY)
# ============================================================================
AETHERRA_DEV_MODE=1
AETHERRA_FORCE_OFFLINE=0
AETHERRA_MOCK_EXTERNAL_SERVICES=0
